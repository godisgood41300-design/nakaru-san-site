{
  "id": "/",
  "name": "Nakaru-San",
  "short_name": "Nakaru-San",
  "description": "An anime and gaming social community for posts, chatrooms, messages, live rooms, and calls.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#050509",
  "theme_color": "#7c3cff",
  "categories": ["social", "entertainment", "games"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Feed",
      "short_name": "Feed",
      "description": "Open the Nakaru-San live feed.",
      "url": "/#feed",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Open Nakaru-San direct messages.",
      "url": "/#messages",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Go Live",
      "short_name": "Go Live",
      "description": "Open Nakaru-San live rooms.",
      "url": "/#live",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
